<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TransRD.Views.GestionarRutaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TransRD.ViewModels"
    x:Name="ThisPage"
    BackgroundColor="#F3F4F6"
    Title="Gestionar Ruta">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12" HeightRequest="44">
            <ImageButton
                Source="ic_back.png"
                BackgroundColor="Transparent"
                WidthRequest="28" HeightRequest="28"
                CornerRadius="14"
                Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1"
                   Text="Gestionar Ruta"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="#111827"
                   VerticalTextAlignment="Center"/>
        </Grid>

        <!-- Card contenedora -->
        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="12"
               HasShadow="False"
               BackgroundColor="White"
               BorderColor="#E5E7EB">

            <Grid RowDefinitions="Auto,*">
                <Label Text="Rutas"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       FontSize="16"
                       Margin="4,0,0,8"/>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Rutas}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10"
                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                  RowDefinitions="Auto,Auto"
                                  BackgroundColor="Transparent">

                                <!-- Separador superior -->
                                <BoxView Grid.ColumnSpan="4"
                                         Grid.Row="0"
                                         HeightRequest="1"
                                         BackgroundColor="#F3F4F6"
                                         Margin="0, -10, 0, 10"
                                         IsVisible="{Binding ShowTopDivider}" />

                                <!-- Icono -->
                                <Frame Grid.Row="1"
                                       Padding="8"
                                       CornerRadius="10"
                                       HasShadow="False"
                                       WidthRequest="36" HeightRequest="36"
                                       BackgroundColor="{Binding IconBg}">
                                    <Image Source="{Binding Icon}"
                                           Aspect="AspectFit"
                                           HeightRequest="18"
                                           WidthRequest="18"/>
                                </Frame>

                                <!-- Textos -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Nombre}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#111827"/>
                                    <Label Text="{Binding Subtitulo}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>
                                </VerticalStackLayout>

                                <!-- Acciones -->
                                <ImageButton Grid.Row="1" Grid.Column="2"
                                             Source="delete_icon.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="28" HeightRequest="28"
                                             Opacity="0.5"
                                             Command="{Binding BindingContext.EliminarCommand, Source={x:Reference ThisPage}}"
                                             CommandParameter="{Binding .}"/>
                                <ImageButton Grid.Row="1" Grid.Column="3"
                                             Source="edit_icon.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="28" HeightRequest="28"
                                             Opacity="0.5"
                                             Command="{Binding BindingContext.EditarCommand, Source={x:Reference ThisPage}}"
                                             CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Frame>

        <!-- Botón Agregar -->
        <Grid Grid.Row="2" Padding="4,12,4,0">
            <Button 
                x:Name="BtnAgregar"
                HeightRequest="44"
                CornerRadius="10"
                BackgroundColor="#2563EB"
                TextColor="White"
                Command="{Binding BindingContext.AgregarCommand, Source={x:Reference ThisPage}}"
                ImageSource="plus_icon.png"
                ContentLayout="Left,12"
                FontAttributes="Bold"
                Text="Agregar ruta" />
        </Grid>

    </Grid>
</ContentPage>
