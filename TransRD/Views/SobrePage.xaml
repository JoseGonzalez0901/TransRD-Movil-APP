<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.SobrePage"
                 Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="White"
    Shell.NavBarHasShadow="False"
    Shell.ForegroundColor="Black"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Acerca de TransRD" FontSize="20" FontAttributes="Bold" TextColor="Black" />
            <Label Text="Versión 1.0.0" FontAttributes="Italic" TextColor="Black"/>
            <Label Text="TransRD es una aplicación diseñada para gestionar rutas, vehículos y pagos de forma eficiente y moderna." TextColor="Black"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
