<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.PersonalDataPage"
             BackgroundColor="#F5F5F5"
             Title="Datos Personales"
             xmlns:viewmodels="clr-namespace:TransRD.ViewModels"
             x:DataType="viewmodels:PersonalDataViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Perfil -->
            <Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="False">
                <HorizontalStackLayout Spacing="12">
                    <Frame Padding="0" CornerRadius="40" HeightRequest="80" WidthRequest="80"
                           IsClippedToBounds="True" BackgroundColor="Transparent" VerticalOptions="Center">
                        <Image Source="avatar_demo.png" WidthRequest="80" HeightRequest="80" Aspect="AspectFill"/>
                    </Frame>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                        <Label Text="{Binding Correo}" FontSize="14" TextColor="Gray"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Información personal -->
            <Frame CornerRadius="16" BackgroundColor="White" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Información personal" FontAttributes="Bold" FontSize="16" TextColor="Black"/>

                    <Label Text="Nombre completo" FontSize="13" TextColor="Gray"/>
                    <Entry Text="{Binding Nombre}" FontSize="14" TextColor="Black"/>

                    <Label Text="Email" FontSize="13" TextColor="Gray"/>
                    <Entry Text="{Binding Correo}" FontSize="14" TextColor="Black"/>

                    <Label Text="Número" FontSize="13" TextColor="Gray"/>
                    <Entry Text="{Binding Telefono}" FontSize="14" TextColor="Black"/>

                    <Label Text="Fecha de nacimiento" FontSize="13" TextColor="Gray"/>
                    <DatePicker Date="{Binding FechaNacimiento}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Notificaciones -->
            <Frame CornerRadius="16" BackgroundColor="White" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Notificaciones" FontAttributes="Bold" FontSize="16" TextColor="Black"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Notificaciones push" FontSize="14" TextColor="Black"/>
                            <Label Text="Reciba actualizaciones en tiempo real" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>
                        <Switch IsToggled="{Binding NotificacionesPush}" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Alertas de retraso" FontSize="14" TextColor="Black"/>
                            <Label Text="Recibir notificaciones de retrasos" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>
                        <Switch IsToggled="{Binding AlertasRetraso}" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Actualizaciones de ruta" FontSize="14" TextColor="Black"/>
                            <Label Text="Cambios en sus rutas" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>
                        <Switch IsToggled="{Binding ActualizacionesRuta}" Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Seguridad -->
            <Frame CornerRadius="16" BackgroundColor="White" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Privacidad y seguridad" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                    <Label Text="Cambiar la contraseña" TextColor="Black"/>
                    <Label Text="Política de privacidad" TextColor="Black"/>
                    <Label Text="Términos de servicio" TextColor="Black"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Guardar -->
            <Button Text="Guardar cambios"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Command="{Binding GuardarCambiosCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
