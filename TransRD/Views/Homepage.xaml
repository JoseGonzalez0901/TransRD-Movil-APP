<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TransRD.ViewModels"
             x:Class="TransRD.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Inicio"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Frame BackgroundColor="#1E3A8A" CornerRadius="16" Padding="16" HasShadow="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Portal principal" FontAttributes="Bold" FontSize="18" TextColor="White"/>
                        <Label Text="Ruta #45A - OMSA" FontSize="13" TextColor="White"/>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="LimeGreen"/>
                        <Label Text="Activo" TextColor="White" FontSize="13"/>
                    </HorizontalStackLayout>
                </Grid>
            </Frame>
            <!-- Tarjeta Estado Ruta -->
            <Frame BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False" BorderColor="#E5E7EB">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Text="Ruta Actual" FontAttributes="Bold" FontSize="14" TextColor="Black"/>
                    <Frame Grid.Column="1"
                       Padding="10,2"
                       CornerRadius="50"
                       BackgroundColor="#22C55E"   
                                        HasShadow="False"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       IsClippedToBounds="True">
                    <Label Text="Activo"
                        TextColor="White"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                                    </Frame>



                    <Label Grid.Row="1" Text="Siguiente Parada" FontSize="12" TextColor="Gray"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SiguienteParada}" FontSize="13" FontAttributes="Bold" TextColor="Black"/>

                    <Label Grid.Row="2" Text="ETA" FontSize="12" TextColor="Gray"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Eta}" FontSize="13" FontAttributes="Bold" TextColor="Black"/>

                    <Label Grid.Row="3" Text="Pasajeros" FontSize="12" TextColor="Gray"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Pasajeros}" FontSize="13" FontAttributes="Bold" TextColor="Black"/>
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <Label Text="Opciones" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">

                <!-- Reportar Problema -->
                <Frame BackgroundColor="#EF4444"
           CornerRadius="12"
           Padding="12"
           WidthRequest="150"
           HeightRequest="50"
           HasShadow="False">
                    <Grid>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReportarProblemaCommand}" />
                        </Grid.GestureRecognizers>

                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="warning_40p.png" WidthRequest="16" HeightRequest="16"/>
                            <Label Text="Reportar" TextColor="White" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

                <!-- Ver Ruta -->
                <Frame BackgroundColor="#3B82F6"
           CornerRadius="12"
           Padding="12"
           WidthRequest="150"
           HeightRequest="50"
           HasShadow="False">
                    <Grid>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VerRutaCommand}" />
                        </Grid.GestureRecognizers>

                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="route_icon.png" WidthRequest="16" HeightRequest="16"/>
                            <Label Text="Ver Ruta" TextColor="White" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

            </HorizontalStackLayout>



            <!-- Alertas recientes -->
            <Label Text="Alertas recientes" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
            <CollectionView ItemsSource="{Binding Alertas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               CornerRadius="12"
                               Padding="10"
                               Margin="0,5"
                               HasShadow="False"
                               BorderColor="#E5E7EB">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="14" TextColor="Black"/>
                                <Label Text="{Binding Descripcion}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy HH:mm}'}" FontSize="10" TextColor="#999"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
