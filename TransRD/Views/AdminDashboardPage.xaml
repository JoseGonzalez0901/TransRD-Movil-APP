<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.AdminDashboardPage"
             xmlns:viewmodels="clr-namespace:TransRD.ViewModels"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <viewmodels:AdminDashboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- Estadísticas principales -->
            <Grid RowSpacing="16" ColumnSpacing="16" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">

                <!-- Vehículos Activos -->
                <Frame Grid.Row="0" Grid.Column="0" CornerRadius="12" HasShadow="False"
                       BorderColor="#E5E7EB" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Vehículos Activos" FontSize="14" TextColor="#6B7280" />
                            <Label Text="{Binding VehiculosActivos}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                       
                    </HorizontalStackLayout>
                </Frame>

                <!-- Usuarios Activos -->
                <Frame Grid.Row="0" Grid.Column="1" CornerRadius="12" HasShadow="False"
                       BorderColor="#E5E7EB" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Usuarios Activos" FontSize="14" TextColor="#6B7280" />
                            <Label Text="{Binding UsuariosActivos}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        
                    </HorizontalStackLayout>
                </Frame>

                <!-- Rutas Activas -->
                <Frame Grid.Row="1" Grid.Column="0" CornerRadius="12" HasShadow="False"
                       BorderColor="#E5E7EB" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Rutas Activas" FontSize="14" TextColor="#6B7280" />
                            <Label Text="{Binding RutasActivas}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        <Frame Padding="4" BackgroundColor="#FFF3ED" CornerRadius="8" HasShadow="False">
                            <Image Source="icon_routes.png" WidthRequest="20" HeightRequest="20" />
                        </Frame>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Alertas -->
                <Frame Grid.Row="1" Grid.Column="1" CornerRadius="12" HasShadow="False"
                       BorderColor="#E5E7EB" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Alertas" FontSize="14" TextColor="#6B7280" />
                            <Label Text="{Binding Alertas}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        <Frame Padding="4" BackgroundColor="#FEE2E2" CornerRadius="8" HasShadow="False">
                            <Image Source="alert_icon.png" WidthRequest="20" HeightRequest="20" />
                        </Frame>
                    </HorizontalStackLayout>
                </Frame>
            </Grid>

            <!-- Acciones -->
            <Label Text="Acciones" FontSize="18" FontAttributes="Bold" TextColor="#111827" />

            <HorizontalStackLayout Spacing="12">
                <!-- Agregar Vehículo -->
                <Frame CornerRadius="12" BackgroundColor="White" BorderColor="#E5E7EB" Padding="12"
                       WidthRequest="100" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Frame BackgroundColor="#EEF4FF" CornerRadius="8" Padding="6" HasShadow="False">
                            <Image Source="addblue_icon.png" WidthRequest="20" HeightRequest="20" />
                        </Frame>
                        <Label Text="Agregar" FontSize="14" HorizontalTextAlignment="Center" TextColor="#111827" />
                        <Label Text="Vehículo" FontSize="14" HorizontalTextAlignment="Center" TextColor="#111827" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarVehiculoCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Gestionar Rutas -->
                <Frame CornerRadius="12" BackgroundColor="White" BorderColor="#E5E7EB" Padding="12"
                       WidthRequest="100" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Frame BackgroundColor="#E9FDF1" CornerRadius="8" Padding="6" HasShadow="False">
                            <Image Source="mapgreen_icon.png" WidthRequest="20" HeightRequest="20" />
                        </Frame>
                        <Label Text="Gestionar" FontSize="14" HorizontalTextAlignment="Center" TextColor="#111827" />
                        <Label Text="Rutas" FontSize="14" HorizontalTextAlignment="Center" TextColor="#111827" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GestionarRutasCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Reportes -->
                <Frame CornerRadius="12" BackgroundColor="White" BorderColor="#E5E7EB" Padding="12"
                       WidthRequest="100" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Frame BackgroundColor="#FFF3ED" CornerRadius="8" Padding="6" HasShadow="False">
                            <Image Source="reportorange_icon.png" WidthRequest="20" HeightRequest="20" />
                        </Frame>
                        <Label Text="Reportes" FontSize="14" HorizontalTextAlignment="Center" TextColor="#111827" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VerReportesCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>
            </HorizontalStackLayout>

            <!-- Estado -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Estado" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <Label Text="Ver" FontSize="14" TextColor="#2563EB" VerticalOptions="Center" Grid.Column="1">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VerEstadoCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <CollectionView ItemsSource="{Binding EstadoTransporte}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12" ColumnDefinitions="Auto,10,*,Auto" RowDefinitions="Auto,Auto">
                                <Frame Padding="4" CornerRadius="8" BackgroundColor="#F3F0FF" Grid.Column="0">
                                    <Image Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" />
                                </Frame>
                                <Label Grid.Column="2" Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                <Frame Grid.Column="3" Padding="6,2" CornerRadius="12" BackgroundColor="{Binding EstadoFondo}">
                                    <Label Text="{Binding Estado}" FontSize="12" TextColor="{Binding EstadoColor}" />
                                </Frame>
                                <Label Grid.Column="2" Grid.Row="1" Text="{Binding Subtexto}" FontSize="14" TextColor="#6B7280" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Alertas -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Alertas" FontSize="18" FontAttributes="Bold" TextColor="#111827" />

                <CollectionView ItemsSource="{Binding AlertasRecientes}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="White" CornerRadius="12" BorderColor="#E5E7EB" Padding="12" HasShadow="False">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                    <Label Text="{Binding Descripcion}" FontSize="14" TextColor="#6B7280" />
                                    <Label Text="{Binding Tiempo}" FontSize="12" TextColor="#9CA3AF" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
