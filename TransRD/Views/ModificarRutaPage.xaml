<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.ModificarRutaPage"
             Title="Agregar Ruta"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame CornerRadius="16" BorderColor="#E5E7EB" BackgroundColor="White" Padding="20" HasShadow="False">
                <VerticalStackLayout Spacing="16">

                    <!-- Datos de la Ruta -->
                    <Label Text="Datos de la Ruta" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                    <Label Text="Nombre de la Ruta" FontSize="14" TextColor="#111827" />
                    <Entry Text="OMSA Ruta 10" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Origen" FontSize="14" TextColor="#111827" />
                    <Entry Text="Av. Máximo Gómez" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Destino" FontSize="14" TextColor="#111827" />
                    <Entry Text="Av. George Washington" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Paradas" FontSize="14" TextColor="#111827" />
                    <Entry Text="7" Keyboard="Numeric" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Horario" FontSize="14" TextColor="#111827" />
                    <Entry Text="8:00 a.m. - 7:00 p.m." BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Estado" FontSize="14" TextColor="#111827" />
                    <Entry Text="Activa" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <!-- Vehículos Asociados -->
                    <Label Text="Vehículos Asociados" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                    <Label Text="Placa" FontSize="14" TextColor="#111827" />
                    <Entry Text="A695142" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Placa" FontSize="14" TextColor="#111827" />
                    <Entry Text="A621663" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Placa" FontSize="14" TextColor="#111827" />
                    <Entry Text="A516512" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <Label Text="Placa" FontSize="14" TextColor="#111827" />
                    <Entry Text="A215663" BackgroundColor="#F9FAFB" HeightRequest="44" />

                    <!-- Botón Guardar -->
                    <Button Text="Guardar"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
