<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.HistorialPage"
             BackgroundColor="White"
              xmlns:controls="clr-namespace:TransRD.Controls"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,0">


            <VerticalStackLayout Padding="0,20,0,10" Spacing="20" BackgroundColor="White">

                <!-- Título -->
                <Label Text="Historial"
           FontSize="20"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           TextColor="Black" />

                <!-- Filtros alineados desde la izquierda -->
                <HorizontalStackLayout HorizontalOptions="Fill" Spacing="2">

                    <!-- TODOS (pegado a la izquierda) -->
                    <Frame BackgroundColor="#2563EB"
               CornerRadius="35"
               Padding="5"
               HasShadow="False"
               HeightRequest="60"
               WidthRequest="80"
               Margin="0,0,0,0"
               BorderColor="White">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">

                            <Label Text="Todos"
                       FontSize="12"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- METRO -->
                    <Frame BackgroundColor="#F2F2F2"
               CornerRadius="35"
               Padding="5"
               HasShadow="False"
              HeightRequest="60"
WidthRequest="80"
Margin="0,0,0,0"
BorderColor="White">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="metro_icon.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="Metro"
                       FontSize="12"
                       TextColor="Black"
                       HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- OMSA -->
                    <Frame BackgroundColor="#F2F2F2"
               CornerRadius="35"
               Padding="5"
               HasShadow="False"
               HeightRequest="60"
WidthRequest="80"
Margin="0,0,0,0"
BorderColor="White">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="omsa_icon.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="OMSA"
                       FontSize="12"
                       TextColor="Black"
                       HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- AUTOS -->
                    <Frame BackgroundColor="#F2F2F2"
               CornerRadius="35"
               Padding="5"
               HasShadow="False"
               HeightRequest="60"
WidthRequest="80"
Margin="0,0,0,0"
BorderColor="White">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="autos_icon.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="Autos"
                       FontSize="12"
                       TextColor="Black"
                       HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </HorizontalStackLayout>

            </VerticalStackLayout>


            <!-- Sección Hoy -->
            <Label Text="Today" FontSize="16" FontAttributes="Bold" Margin="0,20,0,10" TextColor="Black"/>
            <VerticalStackLayout Spacing="10">
                <!-- Viaje 1 -->
                <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🚇 Metro línea 1" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                            <Label Text="2:45 PM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                        </Grid>
                        <Label Text="Centro Olímpico → Villa Mella" FontSize="12" TextColor="Black"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5">
                            <Label Text="⏱ 35 min" FontSize="12" TextColor="Black"/>
                            <Label Text="💵 RD$20" FontSize="12" TextColor="Black"/>
                            <Label Text="Terminado" TextColor="Green" FontSize="12"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Viaje 2 -->
                <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🚌 OMSA" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                            <Label Text="11:20 AM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                        </Grid>
                        <Label Text="Zona Colonial → Gazcue" FontSize="12" TextColor="Black"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5">
                            <Label Text="⏱ 22 min" FontSize="12" TextColor="Black"/>
                            <Label Text="💵 RD$15" FontSize="12" TextColor="Black"/>
                            <Label Text="Terminado" TextColor="Green" FontSize="12"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Ayer -->
            <Label Text="Ayer" FontSize="16" FontAttributes="Bold" Margin="0,20,0,10" TextColor="Black"/>
            <VerticalStackLayout Spacing="10">
                <!-- Carro Público -->
                <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🚗 Carro Público" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                            <Label Text="6:15 PM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                        </Grid>
                        <Label Text="Malecón → Plaza de Armas" FontSize="12" TextColor="Black"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5">
                            <Label Text="⏱ 18 min" FontSize="12" TextColor="Black"/>
                            <Label Text="💵 RD$25" FontSize="12" TextColor="Black"/>
                            <Label Text="Terminado" TextColor="Green" FontSize="12"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Metro línea 2 cancelado -->
                <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🚇 Metro línea 2" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                            <Label Text="2:30 PM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                        </Grid>
                        <Label Text="Mamá Tingó → Villa Mella" FontSize="12" TextColor="Black"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5">
                            <Label Text="⏱ 42 min" FontSize="12" TextColor="Black"/>
                            <Label Text="💵 RD$20" FontSize="12" TextColor="Black"/>
                            <Label Text="Cancelado" TextColor="Red" FontSize="12"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- OMSA Route 8 -->
                <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🚌 OMSA Route 8" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                            <Label Text="9:45 AM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                        </Grid>
                        <Label Text="Los Alcarrizos → Centro" FontSize="12" TextColor="Black"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5">
                            <Label Text="⏱ 28 min" FontSize="12" TextColor="Black"/>
                            <Label Text="💵 RD$15" FontSize="12" TextColor="Black"/>
                            <Label Text="Completed" TextColor="Green" FontSize="12"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Esta semana -->
            <Label Text="Esta semana" FontSize="16" FontAttributes="Bold" Margin="0,20,0,10" TextColor="Black"/>
            <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🚗 Carro Público" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                        <Label Text="Lunes 4:20 PM" FontSize="12" Grid.Column="1" TextColor="Black"/>
                    </Grid>
                    <Label Text="Bella Vista → Naco" FontSize="12" TextColor="Black"/>
                    <HorizontalStackLayout Spacing="15" Margin="0,5">
                        <Label Text="⏱ 15 min" FontSize="12" TextColor="Black"/>
                        <Label Text="💵 RD$30" FontSize="12" TextColor="Black"/>
                        <Label Text="Terminado" TextColor="Green" FontSize="12"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>


            <!-- Resumen mensual -->
            <Frame BorderColor="#eee"
                   Padding="10"
                   CornerRadius="12"
                   HasShadow="False"
                    BackgroundColor="White"
                   Margin="0,20">
                <VerticalStackLayout>
                    <Label Text="Resumen de este mes"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="Black"
               Margin="0,0,0,5" />

                    <Grid ColumnDefinitions="*,*,*">
                        <!-- Viajes totales -->
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="23"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#2563EB" />
                            <Label Text="Viajes\ntotales"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Tiempo de viaje -->
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="12h"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="Black" />
                            <Label Text="Tiempo\nde viaje"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Total gastado -->
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="RD$450"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#16A34A" />
                            <Label Text="Total\ngastado"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
