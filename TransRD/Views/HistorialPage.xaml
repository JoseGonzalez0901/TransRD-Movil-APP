<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TransRD.Converters"
             xmlns:controls="clr-namespace:TransRD.Controls"
             xmlns:vm="clr-namespace:TransRD.ViewModels"
             x:Class="TransRD.Views.HistorialPage"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:HistorialViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CategoriaColorConverter x:Key="CategoriaColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <ScrollView>
        <VerticalStackLayout Padding="20,0">

            <VerticalStackLayout Padding="0,20,0,10" Spacing="20" BackgroundColor="White">

                <!-- Título -->
                <Label Text="Historial" FontSize="20" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="Black" />

                <!-- Filtros alineados desde la izquierda -->
                <HorizontalStackLayout HorizontalOptions="Fill" Spacing="2">

                    <!-- TODOS -->
                    <Frame CornerRadius="35" Padding="5" HasShadow="False"
                           HeightRequest="60" WidthRequest="80" Margin="0"
                           BorderColor="White"
                           BackgroundColor="{Binding CategoriaSeleccionada, Converter={StaticResource CategoriaColorConverter}, ConverterParameter=Todos}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Label Text="Todos" FontSize="12" TextColor="White" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FiltrarCommand}" CommandParameter="Todos" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- METRO -->
                    <Frame CornerRadius="35" Padding="5" HasShadow="False"
                           HeightRequest="60" WidthRequest="80" Margin="0"
                           BorderColor="White"
                           BackgroundColor="{Binding CategoriaSeleccionada, Converter={StaticResource CategoriaColorConverter}, ConverterParameter=Metro}">         
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="icon_metro.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="Metro" FontSize="12" TextColor="Black" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FiltrarCommand}" CommandParameter="Metro" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- OMSA -->
                    <Frame CornerRadius="35" Padding="5" HasShadow="False"
                           HeightRequest="60" WidthRequest="80" Margin="0"
                           BorderColor="White"
                           BackgroundColor="{Binding CategoriaSeleccionada, Converter={StaticResource CategoriaColorConverter}, ConverterParameter=OMSA}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="icon_bus.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="OMSA" FontSize="12" TextColor="Black" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FiltrarCommand}" CommandParameter="OMSA" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- AUTOS -->
                    <Frame CornerRadius="35" Padding="5" HasShadow="False"
                           HeightRequest="60" WidthRequest="80" Margin="0"
                           BorderColor="White"
                           BackgroundColor="{Binding CategoriaSeleccionada, Converter={StaticResource CategoriaColorConverter}, ConverterParameter=Autos}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Image Source="icon_car.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="Autos" FontSize="12" TextColor="Black" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FiltrarCommand}" CommandParameter="Autos" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Sección Hoy -->
            <Label Text="Hoy" FontSize="16" FontAttributes="Bold" Margin="0,20,0,10" TextColor="Black"/>

            <CollectionView ItemsSource="{Binding ViajesFiltrados}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#eee" Padding="10" CornerRadius="12" BackgroundColor="White">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                                    <Label Text="{Binding Hora}" FontSize="12" Grid.Column="1" TextColor="Black"/>
                                </Grid>
                                <Label Text="{Binding Ruta}" FontSize="12" TextColor="Black"/>
                                <HorizontalStackLayout Spacing="15" Margin="0,5">
                                    <Label Text="{Binding Duracion}" FontSize="12" TextColor="Black"/>
                                    <Label Text="{Binding Costo}" FontSize="12" TextColor="Black"/>
                                    <Label Text="{Binding Estado}" FontSize="12" TextColor="{Binding EstadoColor}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Repetir para Ayer y Esta semana si se desea -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
