<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransRD.Views.PrivacidadPage"
             Title="PrivacidadPage">

    <Grid RowDefinitions="*,Auto">

        <!-- Contenido desplazable -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Sección de perfil -->
                <Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="False">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <!-- Imagen circular -->
                        <Frame Padding="0"
                           CornerRadius="40"
                           HeightRequest="80"
                           WidthRequest="80"
                           IsClippedToBounds="True"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center">
                            <Image Source="avatar_demo.png"
                               Aspect="AspectFill"
                               WidthRequest="80"
                               HeightRequest="80"/>
                        </Frame>

                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="María González"
                               FontAttributes="Bold"
                               FontSize="16"/>
                            <Label Text="maria.gonzalez@email.com"
                               FontSize="14"
                               TextColor="Gray"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Compartir ubicación -->
                <Frame CornerRadius="16" BackgroundColor="White" Padding="0" HasShadow="False">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Compartir Ubicación"
                           FontAttributes="Bold"
                           FontSize="16"
                           Padding="16,16,16,8"/>

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="point_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Text="Ubicación del dispositivo" Grid.Column="1" VerticalOptions="Center" Padding="12,0"/>
                            <Image Source="arrow_icon.png" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEE" Margin="16,0"/>

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="location2_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Text="Ubicación en Tiempo Real" Grid.Column="1" VerticalOptions="Center" Padding="12,0"/>
                            <Image Source="arrow_icon.png" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Seguridad de cuenta -->
                <Frame CornerRadius="16" BackgroundColor="White" Padding="0" HasShadow="False">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Seguridad de Cuenta"
                           FontAttributes="Bold"
                           FontSize="16"
                           Padding="16,16,16,8"/>

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="bigshield_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Text="Configurar MFA" Grid.Column="1" VerticalOptions="Center" Padding="12,0"/>
                            <Image Source="arrow_icon.png" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEE" Margin="16,0"/>

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="eye_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Text="Ocultar Datos Personales" Grid.Column="1" VerticalOptions="Center" Padding="12,0"/>
                            <Image Source="arrow_icon.png" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEE" Margin="16,0"/>

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="delete_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Text="Eliminar Cuenta" Grid.Column="1" VerticalOptions="Center" Padding="12,0"/>
                            <Image Source="arrow_icon.png" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón inferior -->
        <Grid Grid.Row="1" Padding="20" BackgroundColor="White">
            <Button Text="Guardar cambios"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50"
                HorizontalOptions="FillAndExpand"/>
        </Grid>
    </Grid>

</ContentPage>