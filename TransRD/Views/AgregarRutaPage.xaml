<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TransRD.Views.AgregarRutaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TransRD.ViewModels"
    x:Name="ThisPage"
    BackgroundColor="#F3F4F6"
    Title="Agregar Ruta">


    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Frame CornerRadius="12"
                   HasShadow="False"
                   Padding="16"
                   BorderColor="#E5E7EB"
                   BackgroundColor="White">

                <VerticalStackLayout Spacing="16">

                    <!-- Sección Datos de la Ruta -->
                    <Label Text="Datos de la Ruta"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#111827" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nombre de la Ruta" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding NombreRuta}" Placeholder="Nombre de la ruta" TextColor="Black" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Origen" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding Origen}" Placeholder="Origen" TextColor="Black" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Destino" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding Destino}" Placeholder="Destino" TextColor="Black"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Paradas" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding Paradas}" Keyboard="Numeric" Placeholder="Cantidad" TextColor="Black" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Horario" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding Horario}" Placeholder="Ej. 8:00 a.m. - 7:00 p.m." TextColor="Black" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Estado" FontSize="14" TextColor="#374151" />
                        <Entry Text="{Binding Estado}" Placeholder="Activa/Inactiva" TextColor="Black" />
                    </VerticalStackLayout>


                </VerticalStackLayout>
            </Frame>

            <!-- Botón Guardar -->
            <Button Text="Guardar"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="44"
                    Command="{Binding GuardarCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
