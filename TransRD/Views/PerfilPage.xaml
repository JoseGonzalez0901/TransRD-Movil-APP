<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TransRD.Controls"
             x:Class="TransRD.Views.PerfilPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*">

        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Encabezado -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Text="Perfil" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                    <StackLayout Grid.Column="1" Orientation="Horizontal">
                        <Image Source="bell.png" HeightRequest="24" />
                        <Frame BackgroundColor="Red" CornerRadius="10" Padding="4"
                               HorizontalOptions="End" VerticalOptions="Start">
                            <Label Text="{Binding Notificaciones}" TextColor="White" FontSize="10" />
                        </Frame>
                    </StackLayout>
                </Grid>

                <!-- Usuario -->
                <Frame CornerRadius="10" BorderColor="#E0E0E0" Padding="10" HasShadow="False" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="profile_placeholder.png" WidthRequest="60" HeightRequest="60" 
                               BackgroundColor="#eee" Aspect="AspectFill" VerticalOptions="Center" Clip="Circle" />
                        <VerticalStackLayout VerticalOptions="Center" WidthRequest="200">
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                            <Label Text="{Binding Correo}" FontSize="13" TextColor="Gray"/>
                            <Label Text="{Binding MiembroDesde}" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

                <Label Text="Ajustes" FontAttributes="Bold" FontSize="16" TextColor="Black" />

                <VerticalStackLayout Spacing="12">

                    <!-- Información personal -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IrAInformacionPersonalCommand}" />
                            </Grid.GestureRecognizers>

                            <Frame WidthRequest="40" HeightRequest="40" BackgroundColor="#FEF5EC"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="user_icon.png" WidthRequest="22" HeightRequest="22" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Información personal" FontAttributes="Bold"
                                       FontSize="14" TextColor="#1C1C1E" />
                                <Label Text="Actualizar Datos" FontSize="12" TextColor="#8E8E93" />
                            </VerticalStackLayout>

                            <Image Source="arrow_right.png" Grid.Column="2"
                                   WidthRequest="16" HeightRequest="16" />
                        </Grid>
                    </Frame>

                    <!-- Métodos de pago -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IrAMetodosPagoCommand}" />
                            </Grid.GestureRecognizers>

                            <Frame WidthRequest="40" HeightRequest="40" BackgroundColor="#E6F6EA"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="credit_card_icon.png" WidthRequest="22" HeightRequest="22" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Métodos de pago" FontAttributes="Bold"
                                       FontSize="14" TextColor="#1C1C1E" />
                                <Label Text="Agregar método de pago" FontSize="12" TextColor="#8E8E93" />
                            </VerticalStackLayout>

                            <Image Source="arrow_right.png" Grid.Column="2"
                                   WidthRequest="16" HeightRequest="16" />
                        </Grid>
                    </Frame>

                    <!-- Privacidad -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IrAPrivacidadCommand}" />
                            </Grid.GestureRecognizers>

                            <Frame WidthRequest="40" HeightRequest="40" BackgroundColor="#F5F2FF"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="shield_icon.png" WidthRequest="22" HeightRequest="22" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Privacidad" FontAttributes="Bold"
                                       FontSize="14" TextColor="#1C1C1E" />
                                <Label Text="Protección de datos" FontSize="12" TextColor="#8E8E93" />
                            </VerticalStackLayout>

                            <Image Source="arrow_right.png" Grid.Column="2"
                                   WidthRequest="16" HeightRequest="16" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>

                <!-- Soporte -->
                <Label Text="Información y Soporte" FontAttributes="Bold" FontSize="16" TextColor="Black" />

                <VerticalStackLayout Spacing="12">

                    <!-- Centro de ayuda -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrACentroDeAyudaCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Centro de Ayuda" FontAttributes="Bold"
                                   TextColor="#1C1C1E" FontSize="14" />
                            <Label Text="FAQ y Guías" FontSize="12" TextColor="#8E8E93" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Contacto -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrAContactoCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Contacto" FontAttributes="Bold"
                                   TextColor="#1C1C1E" FontSize="14" />
                            <Label Text="Obtén ayuda de nuestro equipo" FontSize="12" TextColor="#8E8E93" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Sobre -->
                    <Frame CornerRadius="12" Padding="12" BackgroundColor="White"
                           BorderColor="#E0E0E0" HasShadow="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASobreCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sobre" FontAttributes="Bold"
                                   TextColor="#1C1C1E" FontSize="14" />
                            <Label Text="Versión de app e info" FontSize="12" TextColor="#8E8E93" />
                        </VerticalStackLayout>
                    </Frame>
                    <Button Text="Cerrar sesión"
        Command="{Binding LogoutCommand}"
        BackgroundColor="#EF4444"
        TextColor="White"
        CornerRadius="12"
        FontAttributes="Bold"
        FontSize="14"
        HeightRequest="50" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
